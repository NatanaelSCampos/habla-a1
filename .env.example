# Somente para geração local; estas variáveis nunca são carregadas pelo app.
AZURE_SPEECH_KEY=
AZURE_SPEECH_ENDPOINT=https://SUA-REGIAO.api.cognitive.microsoft.com/
# Alternativa ao endpoint:
# AZURE_SPEECH_REGION=eastus
# O gerador do Habla fixa es-MX-DaliaNeural, mesmo que outro projeto use es-ES.

# Configuração PÚBLICA do app Web Firebase (console > configurações > seus apps).
# Execute npm run configure:firebase depois de preencher. Não use chaves Admin aqui.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
